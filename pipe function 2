from multiprocessing import Process, Pipe
import time

def producer(conn):
    for i in range(1, 6):
        print("Produced:", i)
        conn.send(i)
        time.sleep(1)

    conn.send("END")

def consumer(conn):
    while True:
        item = conn.recv()

        if item == "END":
            break

        print("Consumed:", item)

if _name_ == "_main_":
    parent_conn, child_conn = Pipe()

    p1 = Process(target=producer, args=(parent_conn,))
    p2 = Process(target=consumer, args=(child_conn,))

    p1.start()
    p2.start()

    p1.join()
    p2.join()
