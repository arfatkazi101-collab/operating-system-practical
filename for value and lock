from multiprocessing import Process, Value, Lock

def increment(counter, lock):
    for i in range(5000):
        lock.acquire()
        counter.value += 1
        lock.release()

if _name_ == "_main_":
    counter = Value('i', 0)
    lock = Lock()

    p1 = Process(target=increment, args=(counter, lock))
    p2 = Process(target=increment, args=(counter, lock))

    p1.start()
    p2.start()

    p1.join()
    p2.join()

    print("Final Counter:", counter.value)
