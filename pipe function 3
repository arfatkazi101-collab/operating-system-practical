from multiprocessing import Process, Pipe
import time

def sender(conn):
    time.sleep(5)
    conn.send("Hello")

def receiver(conn):
    print("Waiting for message...")
    message = conn.recv()
    print("Received:", message)

if _name_ == "_main_":
    parent_conn, child_conn = Pipe()

    p1 = Process(target=sender, args=(parent_conn,))
    p2 = Process(target=receiver, args=(child_conn,))

    p1.start()
    p2.start()

    p1.join()
    p2.join()
